<?xml version="1.0"?>
<workout_file>
  <author>openCycle</author>
  <name>Simple Test</name>
  <description>Warmup, intervals, steady, cooldown</description>
  <sportType>bike</sportType>
  <tags>
    <tag name="ENDURANCE"/>
    <tag name="INTERVALS"/>
  </tags>
  <workout>
    <Warmup Duration="600" PowerLow="0.4" PowerHigh="0.75"/>
    <IntervalsT Repeat="3" OnDuration="300" OffDuration="300" OnPower="1.05" OffPower="0.55"/>
    <SteadyState Duration="600" Power="0.8"/>
    <Cooldown Duration="300" PowerLow="0.75" PowerHigh="0.4"/>
  </workout>
</workout_file>
